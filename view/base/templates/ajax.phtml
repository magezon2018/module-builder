<?php
$id                 = time() . uniqid();
$htmlId             = 'magezon' . $id;
$targetId           = $block->getTargetId();
$ajaxData           = $block->getAjaxData() ? $block->getAjaxData() : [];
$ajaxData['handle'] = $block->getRequest()->getFullActionName();

$idJs       = $block->escapeJs($id);
$htmlIdJs   = $block->escapeJs($htmlId);
$targetIdJs = $block->escapeJs($targetId);
?>
<?php if (isset($ajaxData['load_builder_url']) && $ajaxData['load_builder_url']) { ?>
<div class="mgz-spinner mgz-profile-spinner <?= $block->escapeHtmlAttr($htmlId) ?>-spinner"><i></i></div>
<div id="<?= $block->escapeHtmlAttr($id) ?>-wrapper"></div>
<script type="text/javascript">
	require(['jquery'], function($) {
		var parent = $('#<?= /* @noEscape */ $targetIdJs ?>').parent().parent();
		var data = <?= /* @noEscape */ json_encode($ajaxData, JSON_FORCE_OBJECT) ?>;
		data['target_id']    = '<?= /* @noEscape */ $targetIdJs ?>';
		data['html_id']      = '<?= /* @noEscape */ $htmlIdJs ?>';
		$.ajax({
            url: '<?= $block->escapeJs($block->getUrl($ajaxData['load_builder_url'])) ?>',
            type:'POST',
            data: data,
            success: function(html) {
            	$('#<?= /* @noEscape */ $idJs ?>-wrapper').html(html);
            }
        });
	});
</script>
<?php } ?>
